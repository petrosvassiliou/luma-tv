{
  "id": "app.lumatv.client",
  "name": "Luma TV",
  "short_name": "Luma",
  "description": "Next-Gen High-Luminance Stream, M3U & Xtream Player for macOS, Android & ChromeOS.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#090A0F",
  "theme_color": "#090A0F",
  "categories": ["entertainment", "video", "multimedia"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/luma-logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "audio/x-mpegurl": [".m3u", ".m3u8"],
        "application/vnd.apple.mpegurl": [".m3u8"]
      }
    }
  ],
  "shortcuts": [
    {
      "name": "Live TV & EPG",
      "short_name": "EPG",
      "description": "Direkt in das virtualisierte 2D-EPG-Grid starten",
      "url": "/?view=epg"
    },
    {
      "name": "Luma Multiview (4x Sport)",
      "short_name": "Multiview",
      "description": "4 Live-Streams gleichzeitig im Bento-Grid öffnen",
      "url": "/?view=multiview"
    }
  ]
}
