rules_version = '2';

// ===============================================================
// Assumed Data Model — Luma TV Zero-Knowledge Cloud Sync Vault
// ===============================================================
//
// This security rules file enforces strict ownership, schema, type,
// cryptographic envelope parameters, and payload size bounds for:
//
// Collection: /users/{userId}/lumaSync/{docId}
// Document ID: 'vault' (singleton per authenticated Firebase Auth user)
// Fields:
//   - version: int (required, allowed: 1 or 2) - Encrypted envelope format version
//   - kdf: string (required, exact: 'PBKDF2-SHA256-150k') - Key derivation parameters
//   - alg: string (required, exact: 'AES-256-GCM') - Authenticated cipher identifier
//   - saltBase64: string (required, 16..128 chars) - Base64-encoded PBKDF2 random salt
//   - ivBase64: string (required, 12..64 chars) - Base64-encoded AES-GCM 96-bit IV
//   - cipherBase64: string (required, 16..900000 chars) - Base64 ciphertext + GCM auth tag
//   - updatedAt: int (required, > 0) - Client vault encryption epoch timestamp (ms)
//   - deviceId: string (optional, 0..128 chars) - Originating client device identifier
//   - deviceLabel: string (optional, 0..128 chars) - Human-readable device label
//   - schemaVersion: int (optional, 1..10) - Plaintext payload schema version metadata
//
// All other collections and documents are denied by default.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Verify the caller is signed in via Firebase Authentication
    function isAuthenticated() {
      return request.auth != null && request.auth.uid is string && request.auth.uid.size() > 0;
    }

    // Verify the authenticated user strictly matches the {userId} path segment
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verify UID field (if present on a document) matches authenticated user on create
    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
             request.resource.data.uid == request.auth.uid;
    }

    // Verify UID field (if present on a document) is not modified on update
    function uidNotModified() {
      return !('uid' in request.resource.data) ||
             request.resource.data.uid == resource.data.uid;
    }

    // Validate all required fields exist on the incoming document map
    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    // Validate the incoming document map contains no extraneous/unapproved keys
    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    // Validate a required string field's type and character length bounds
    function isValidBoundedString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Validate an optional string field (if present, must be string within maxLen)
    function isValidOptionalString(data, field, maxLen) {
      return !(field in data) ||
             (data[field] is string && data[field].size() <= maxLen);
    }

    // Validate an optional integer field within inclusive [minVal, maxVal] bounds
    function isValidOptionalIntRange(data, field, minVal, maxVal) {
      return !(field in data) ||
             (data[field] is int && data[field] >= minVal && data[field] <= maxVal);
    }

    // ===============================================================
    // Domain Validators (Applied on BOTH create and update)
    // ===============================================================

    function isValidLumaSyncVault(data) {
      let requiredFields = [
        'version',
        'kdf',
        'alg',
        'saltBase64',
        'ivBase64',
        'cipherBase64',
        'updatedAt'
      ];
      let allowedFields = [
        'version',
        'kdf',
        'alg',
        'saltBase64',
        'ivBase64',
        'cipherBase64',
        'updatedAt',
        'deviceId',
        'deviceLabel',
        'schemaVersion'
      ];

      return hasRequiredFields(data, requiredFields) &&
             hasOnlyAllowedFields(data, allowedFields) &&
             data.version is int && (data.version == 1 || data.version == 2) &&
             data.kdf is string && data.kdf == 'PBKDF2-SHA256-150k' &&
             data.alg is string && data.alg == 'AES-256-GCM' &&
             isValidBoundedString(data.saltBase64, 16, 128) &&
             isValidBoundedString(data.ivBase64, 12, 64) &&
             isValidBoundedString(data.cipherBase64, 16, 900000) &&
             data.updatedAt is int && data.updatedAt > 0 &&
             isValidOptionalString(data, 'deviceId', 128) &&
             isValidOptionalString(data, 'deviceLabel', 128) &&
             isValidOptionalIntRange(data, 'schemaVersion', 1, 10);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Zero-Knowledge AES-256-GCM Encrypted Luma Sync Vault
    match /users/{userId}/lumaSync/{docId} {
      allow get: if isOwner(userId) && docId == 'vault';
      allow list: if false;

      allow create: if isOwner(userId) &&
                       docId == 'vault' &&
                       uidUnchanged() &&
                       isValidLumaSyncVault(request.resource.data);

      allow update: if isOwner(userId) &&
                       docId == 'vault' &&
                       uidNotModified() &&
                       isValidLumaSyncVault(request.resource.data);

      allow delete: if isOwner(userId) && docId == 'vault';
    }

    // Default deny all reads and writes to all other collections and paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
