{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luma",
  "version": "0.3.0-beta.1",
  "identifier": "app.lumatv.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Luma TV",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 20
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Entertainment",
    "shortDescription": "Next-Gen High-Luminance Stream, M3U & Xtream Player",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["m3u", "m3u8"],
        "name": "M3U Stream Playlist",
        "description": "Luma TV Broadcast Playlist",
        "role": "Viewer",
        "mimeType": "application/vnd.apple.mpegurl"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "./Entitlements.plist"
    },
    "android": {
      "minSdkVersion": 28
    }
  }
}
